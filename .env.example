# Haqqi — Environment Variables (Production: Supabase + Vercel)
# Copy this file to `.env` and fill in your values.

# ============================================================
# DATABASE (Supabase PostgreSQL)
# ============================================================
# Get these from: Supabase Dashboard → Project Settings → Database → Connection string
#
# DATABASE_URL: Use the connection pooler URL (ports 6543) for serverless (Vercel)
# DIRECT_URL: Use the direct connection URL (port 5432) for migrations
# SHADOW_DATABASE_URL: Same as DIRECT_URL but for a shadow DB (used by Prisma migrate)
#
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true

DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres
SHADOW_DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres

# ============================================================
# SUPABASE (Storage + Auth — Phase 3 production hardening)
# ============================================================
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=[YOUR_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SERVICE_ROLE_KEY]
SUPABASE_BUCKET=evidence

# ============================================================
# AI / LLM (z-ai-web-dev-sdk)
# ============================================================
# The SDK auto-configures from ~/.z-ai-config or these env vars
# On Vercel, set these in Project Settings → Environment Variables
ZAI_BASE_URL=
ZAI_API_KEY=

# ============================================================
# NOTIFICATION PROVIDERS (PRD §6.6)
# ============================================================
# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# WhatsApp Business API
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Transactional Email (Resend, SendGrid, etc.)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=onboarding@haqqi.jo

# ============================================================
# AUTH (NextAuth.js — for production, replacing demo user)
# ============================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=

# ============================================================
# MONITORING (PRD §6.1)
# ============================================================
SENTRY_DSN=

# Analytics (self-hosted per PRD §6.1 — Plausible or Matomo)
PLAUSIBLE_DOMAIN=
MATOMO_URL=

# ============================================================
# APP CONFIG
# ============================================================
# Node environment
NODE_ENV=production

# For local development, set NODE_ENV=development and use SQLite:
# DATABASE_URL=file:/home/z/my-project/db/custom.db
