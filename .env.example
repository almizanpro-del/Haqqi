# Haqqi — Environment Variables (Production: Supabase + Vercel)
# Copy this file to `.env` and fill in your values.

# ============================================================
# DATABASE (Supabase PostgreSQL — required for Vercel deployment)
# ============================================================
# Get these from: Supabase Dashboard → Project Settings → Database → Connection string
#
# DATABASE_URL: Use the connection pooler URL (port 6543) for serverless (Vercel)
# DIRECT_URL: Use the direct connection URL (port 5432) for migrations
#
# BOTH are required when DATABASE_URL starts with postgresql://
# The postinstall script auto-detects PostgreSQL and switches the Prisma provider.
#
# Format: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

DATABASE_URL=postgresql://postgres.[YOUR_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.[YOUR_REF]:[YOUR_PASSWORD]@aws-0-[REGION].supabase.com:5432/postgres

# For local dev (SQLite), use this instead:
# DATABASE_URL=file:./db/custom.db

# ============================================================
# SUPABASE (Storage + Auth — Phase 3 production hardening)
# ============================================================
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=[YOUR_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SERVICE_ROLE_KEY]
SUPABASE_BUCKET=evidence

# ============================================================
# AI / LLM (z-ai-web-dev-sdk)
# ============================================================
# The SDK auto-configures from ~/.z-ai-config or these env vars
# On Vercel, set these in Project Settings → Environment Variables
ZAI_BASE_URL=
ZAI_API_KEY=

# ============================================================
# NOTIFICATION PROVIDERS (PRD §6.6)
# ============================================================
# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# WhatsApp Business API
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Transactional Email (Resend, SendGrid, etc.)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=onboarding@haqqi.jo

# ============================================================
# AUTH (NextAuth.js — for production, replacing demo user)
# ============================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=

# ============================================================
# MONITORING (PRD §6.1)
# ============================================================
SENTRY_DSN=

# Analytics (self-hosted per PRD §6.1 — Plausible or Matomo)
PLAUSIBLE_DOMAIN=
MATOMO_URL=

# ============================================================
# APP CONFIG
# ============================================================
# Node environment
NODE_ENV=production

# For local development, set NODE_ENV=development and use SQLite:
# DATABASE_URL=file:/home/z/my-project/db/custom.db
