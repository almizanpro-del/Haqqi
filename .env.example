# Haqqi — Environment Variables Example
# Copy this file to `.env` and fill in your values.

# Database (SQLite for dev; switch to Postgres URL for production)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# z-ai-web-dev-sdk configuration (LLM provider)
# Either set these env vars OR create a `.z-ai-config` JSON file in the project root
# See: https://github.com/almizanpro-del/Haqqi for SDK docs
ZAI_BASE_URL=
ZAI_API_KEY=
ZAI_CHAT_ID=
ZAI_USER_ID=

# Notification providers (Phase 3 — PRD §6.6)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# Storage (Phase 3 — replaces local file URLs for evidence uploads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=evidence

# Auth (Phase 3 — currently MVP uses a demo victim user)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Monitoring (Phase 3 — PRD §6.1)
SENTRY_DSN=

# Analytics (self-hosted per PRD §6.1)
PLAUSIBLE_DOMAIN=
MATOMO_URL=
