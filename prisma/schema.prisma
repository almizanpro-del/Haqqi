// Haqqi PRD v3.0 — Prisma schema
// AUTO-SWITCH: uses SQLite for local dev, PostgreSQL for production (Vercel/Supabase)
// The provider is determined by the DATABASE_URL scheme at runtime via a prisma generator
// that reads the env. For Vercel deployment, set DATABASE_URL to a postgresql:// connection string.
// The build will automatically use the PostgreSQL provider.
//
// For local dev: DATABASE_URL=file:./db/custom.db → SQLite
// For production: DATABASE_URL=postgresql://... → PostgreSQL
//
// To switch manually: run `bun run scripts/switch-db.ts sqlite|postgres`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // This is a Prisma multi-provider trick: we use env("DATABASE_PROVIDER")
  // which defaults to "sqlite" for dev. On Vercel, set DATABASE_PROVIDER=postgresql
  // OR simply set DATABASE_URL to a postgresql:// URL and the postinstall script
  // will swap the schema automatically.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?
  role      String   @default("victim") // victim | lawyer | admin | regulator
  language  String   @default("ar")
  name      String?
  createdAt DateTime @default(now())
  cases              Case[]
  drafts             Draft[]
  engagementLetters  EngagementLetter[]
  caseAccess         CaseAccess[]
  consents           ConsentRecord[]
  notifications      Notification[]
}

model Case {
  id                  String      @id @default(cuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id])
  intakeJson          String       // JSON — output of AI intake (7 stages)
  stage               Int         @default(0) // current intake stage (0..7)
  completed           Boolean     @default(false)
  status              String      @default("active") // active | settled | closed | archived (v3.2 §5.10)
  accidentDate        DateTime?
  location            String?
  accidentType        String?
  injuries            String?
  otherPartyInsured   Boolean?
  createdAt           DateTime    @default(now())
  claims              Claim[]
  drafts              Draft[]
  evidence            Evidence[]
  claimLogs           ClaimLog[]
  handoffPackets      HandoffPacket[]
  courtFilings        CourtFiling[]
  engagementLetters   EngagementLetter[]
  caseAccess          CaseAccess[]
  statusHistory       CaseStatusHistory[]
  deadlines           CaseDeadline[]
  notifications       Notification[]
}

model Claim {
  id            String       @id @default(cuid())
  caseId        String
  case          Case         @relation(fields: [caseId], references: [id])
  insurerName   String?
  policyNumber  String?
  status        String?
  amountClaimed Float?
  amountOffered Float?
  amountPaid    Float?
  createdAt     DateTime     @default(now())
  documents     Document[]
  claimLogs     ClaimLog[]
  complaints    Complaint[]
}

model Document {
  id         String   @id @default(cuid())
  claimId    String
  claim      Claim    @relation(fields: [claimId], references: [id])
  type       String
  fileName   String
  fileUrl    String?
  uploadedAt DateTime @default(now())
}

model Evidence {
  id         String   @id @default(cuid())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id])
  type       String   // police_report | croquis | photo | medical | bill | salary_slip | correspondence
  fileName   String
  fileUrl    String?
  note       String?
  uploadedAt DateTime @default(now())
  hash       EvidenceHash?
}

model ClaimLog {
  id            String    @id @default(cuid())
  caseId        String
  case          Case      @relation(fields: [caseId], references: [id])
  claimId       String?
  claim         Claim?    @relation(fields: [claimId], references: [id])
  contactDate   DateTime
  contactPerson String?
  summary       String
  outcome       String?
  badFaithFlag  String?   // delay | unnecessary_request | lowball | misrepresentation | none
  createdAt     DateTime  @default(now())
}

model Draft {
  id                  String    @id @default(cuid())
  caseId              String?
  case                Case?     @relation(fields: [caseId], references: [id])
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  templateType        String    // insurer_demand | cbj_complaint | statement_of_claim | settlement_release | power_of_attorney | evidence_list | expert_request
  version             Int       @default(1)
  content             String
  plainArabicVersion  String?
  legalArabicVersion  String?
  citations           String      // JSON array of {source, article_id, topic, language}
  reviewStatus        String    @default("pending_review") // pending_review | approved | rejected | sent
  reviewedByLawyerId  String?
  reviewComments      String?
  reviewedAt          DateTime?
  sentAt              DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  reviewLogs          ReviewLog[]
}

model Lawyer {
  id               String   @id @default(cuid())
  name             String
  firm             String?
  location         String?
  languages        String  // Array
  feeModel         String?
  expertise        String  // Array
  contactEmail     String?
  contactPhone     String?
  bio              String?
  successRate      Float?   // self-reported (PRD §5.2.4)
  isVerified       Boolean  @default(false)
  isLegalReviewer  Boolean  @default(false)
  createdAt        DateTime @default(now())
  reviews          LawyerReview[]
  handoffPackets   HandoffPacket[]
  engagementLetters EngagementLetter[]
  verification     LawyerVerification?
}

model LegalRulesConfig {
  id                  String    @id @default(cuid())
  version             Int
  rulesJson           String      // JSON: compensation categories, ranges, deadlines, doc checklists
  isActive            Boolean   @default(false)
  approvedByLawyerId  String?
  approvedAt          DateTime?
  createdAt           DateTime  @default(now())
}

model LegalTemplate {
  id                  String    @id @default(cuid())
  templateType        String
  version             Int
  contentMdx          String
  isActive            Boolean   @default(false)
  approvedByLawyerId  String?
  approvedAt          DateTime?
  createdAt           DateTime  @default(now())
}

model LegalDocument {
  id                  String    @id @default(cuid())
  title               String
  content             String
  source              String?
  articleId           String?
  topics              String   // Array
  language            String    @default("ar")
  lawyerVerified      Boolean   @default(false)
  verifiedByLawyerId  String?
  verifiedAt          DateTime?
  createdAt           DateTime  @default(now())
  // Stored as Unsupported type since Prisma doesn't natively support pgvector yet
  // We interact with it via raw SQL ($executeRaw, $queryRaw)

}

// Note: The pgvector extension and ivfflat index must be created via SQL migration:
// CREATE EXTENSION IF NOT EXISTS vector;
// CREATE INDEX ON "LegalDocument" USING ivfflat (embedding vector_cosine_ops) WITH (lists = 100);

model Story {
  id           String    @id @default(cuid())
  accidentDate DateTime?
  insurerName  String?
  description  String
  outcome      String?
  isApproved   Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

model CorruptionReport {
  id           String   @id @default(cuid())
  reportDate   DateTime @default(now())
  location     String?
  description  String
  evidenceUrls String  // Array
  isAnonymous  Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Complaint {
  id           String    @id @default(cuid())
  claimId      String
  claim        Claim     @relation(fields: [claimId], references: [id])
  target       String    // insurer | cbj | court
  templateType String?
  content      String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
}

model HandoffPacket {
  id                  String   @id @default(cuid())
  caseId              String
  case                Case     @relation(fields: [caseId], references: [id])
  lawyerId            String?
  lawyer              Lawyer?  @relation(fields: [lawyerId], references: [id])
  includedDocumentIds String  // Array
  includedDraftIds    String  // Array
  message             String?  // optional cover note from user to lawyer
  status              String   @default("sent") // sent | viewed | accepted | declined
  sentAt              DateTime @default(now())
}

model ReviewLog {
  id        String   @id @default(cuid())
  draftId   String
  draft     Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  action    String   // submitted | approved | rejected | sent | generated | edited
  actorId   String?
  comments  String?
  createdAt DateTime @default(now())
}

// === Phase 3 models (PRD §5.3) ===

model LawyerReview {
  id        String   @id @default(cuid())
  lawyerId  String
  lawyer    Lawyer   @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  userId    String?
  rating    Int      // 1..5
  comment   String?
  isVerifiedUser Boolean @default(false) // PRD §5.2.4: reviews restricted to verified accounts
  createdAt DateTime @default(now())
}

model EngagementLetter {
  id           String    @id @default(cuid())
  lawyerId     String
  lawyer       Lawyer    @relation(fields: [lawyerId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  caseId       String?
  case         Case?     @relation(fields: [caseId], references: [id])
  templateType String    // contingency | hourly_fixed
  content      String
  variablesJson String      // JSON of filled variables
  signedByUser Boolean    @default(false)
  signedByLawyer Boolean  @default(false)
  userSignedAt DateTime?
  lawyerSignedAt DateTime?
  status       String    @default("draft") // draft | signed_by_user | fully_signed | voided
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CourtFiling {
  id           String    @id @default(cuid())
  caseId       String
  case         Case      @relation(fields: [caseId], references: [id])
  filingType   String    // statement_of_claim | expert_request | appeal | enforcement
  courtName    String?
  content      String
  status       String    @default("draft") // draft | lawyer_approved | filed | rejected
  filedAt      DateTime?
  createdAt    DateTime  @default(now())
}

model ForumTopic {
  id           String    @id @default(cuid())
  title        String
  category     String    // general | insurance | medical | court | corruption | support
  body         String
  authorId     String?
  authorDisplayName String? // anonymous display name if no user
  isPinned     Boolean   @default(false)
  isLocked     Boolean   @default(false)
  views        Int       @default(0)
  createdAt    DateTime  @default(now())
  posts        ForumPost[]
}

model ForumPost {
  id           String    @id @default(cuid())
  topicId      String
  topic        ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorId     String?
  authorDisplayName String?
  body         String
  isModeratorApproved Boolean @default(false)
  isLawyerAnswer Boolean @default(false) // PRD §5.3.4: verified lawyer/NGO Q&A participation
  createdAt    DateTime  @default(now())
}

model RegulatorStat {
  // Aggregated, anonymized complaint/outcome data for the regulator dashboard (PRD §5.3.3)
  // k-anonymity applied at the query layer — never store individual case data here
  id           String    @id @default(cuid())
  period       String    // e.g. "2026-Q3"
  insurerName  String    // bucketed; small insurers grouped as "Other"
  totalComplaints Int
  resolvedFavorably Int
  avgResolutionDays Float?
  badFaithReports Int
  createdAt    DateTime  @default(now())
}

model NotificationLog {
  // Tracks every outbound notification (PRD §6.6) for audit + retry
  id           String    @id @default(cuid())
  userId       String?
  caseId       String?
  channel      String    // sms | whatsapp | email | in_app
  template     String    // e.g. "reminder_police_report", "draft_approved"
  recipient    String    // phone / email / user id
  payload      String       // JSON of variables
  status       String    @default("queued") // queued | sent | delivered | failed
  providerMessageId String?
  attempts     Int       @default(0)
  lastError    String?
  scheduledFor DateTime?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
}

// === Gap-closure models (audit-feedback driven) ===

// C1 — Multi-user case access: family members, assigned lawyer, etc.
model CaseAccess {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId      String   // the granted user
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   // owner | family_representative | assigned_lawyer | viewer
  grantedBy   String?  // userId who granted access
  grantedAt   DateTime @default(now())
  revokedAt   DateTime?

  @@unique([caseId, userId])
}

// C4 — Lawyer verification: bar ID + license upload + admin approval workflow
model LawyerVerification {
  id              String    @id @default(cuid())
  lawyerId        String    @unique
  lawyer          Lawyer    @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  barId           String    // Jordan Bar Association number
  licenseNumber   String?
  licenseFileUrl  String?   // uploaded scan of license (Supabase Storage in prod)
  lawFirmName     String?
  practiceAreas   String  // Array
  status          String    @default("pending") // pending | approved | rejected
  reviewedByAdminId String?
  reviewNotes     String?
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
}

// C6 — Canonical audit log: who did what, when, on what entity
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?  // userId (null = system)
  actorRole   String?  // victim | lawyer | admin | regulator | system
  action      String   // e.g. "draft.generated", "case.access.granted", "rag.doc.verified"
  entityType  String   // case | draft | evidence | lawyer | legal_document | user | ...
  entityId    String?
  caseId      String?
  metadata    String     // JSON of action-specific context
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
}

// I8 — Evidence chain-of-custody: hash + immutable timestamp
// Augments the existing Evidence model with cryptographic integrity
// (added as separate model to preserve backward compat with existing rows)
model EvidenceHash {
  id           String   @id @default(cuid())
  evidenceId   String   @unique
  evidence     Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  sha256       String   // SHA-256 of file contents
  fileSize     Int?
  mimeType     String?
  uploadedAt   DateTime @default(now()) // immutable — never updated
  // Future: blockchain anchor / notary timestamp
}

// I9 — Consent versioning (PDPL compliance)
model ConsentRecord {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType     String   // terms_of_service | privacy_policy | not_legal_advice | data_processing
  version         String   // semantic version of the document accepted
  documentHash    String?  // hash of the exact text accepted
  acceptedAt      DateTime @default(now())
  ipAddress       String?
  userAgent       String?
  withdrawnAt     DateTime?
}

// I11 — AI answer feedback (thumbs up/down) on intake + RAG
model AiFeedback {
  id          String   @id @default(cuid())
  userId      String?
  feature     String   // intake | rag_search | drafting
  messageId   String?  // reference to the AI message (intake turn / RAG result / draft)
  query       String?  // the user's input that produced the answer
  answer      String?  // the AI's answer (truncated)
  rating      String   // up | down
  comment     String?
  createdAt   DateTime @default(now())
}

// W14 — Data export / deletion request (PDPL right to be forgotten)
model DataSubjectRequest {
  id          String   @id @default(cuid())
  userId      String?
  userEmail   String?  // captured even if userId is null
  requestType String   // export | deletion | correction
  status      String   @default("pending") // pending | in_progress | fulfilled | rejected
  fulfillmentNote String?
  fulfilledBy String?  // admin userId who fulfilled
  requestedAt DateTime @default(now())
  fulfilledAt DateTime?
}

// === v3.2 NEW MODELS ===

// 5.10 — Case lifecycle status history
model CaseStatusHistory {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  oldStatus   String?
  newStatus   String   // active | settled | closed | archived
  changedBy   String?  // userId
  reason      String?
  createdAt   DateTime @default(now())
}

// 5.1.2b — Case deadlines (hard legal deadlines, separate from workflow tasks)
model CaseDeadline {
  id                  String   @id @default(cuid())
  caseId              String
  case                Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  deadlineType        String   // insurer_response | cbj_complaint | statute_of_limitations | custom
  dueDate             DateTime
  sourceRulesConfigId String?  // which legal_rules_config version generated this
  status              String   @default("upcoming") // upcoming | met | missed
  reminderSentAt      DateTime?
  createdAt           DateTime @default(now())
}

// 5.5 — Lawyer applications (separate from live lawyers table, per v3.2 §5.5)
model LawyerApplication {
  id                  String   @id @default(cuid())
  applicantUserId     String?
  applicantName       String
  applicantEmail      String
  barLicenseNumber    String
  licenseDocumentUrl  String
  firm                String?
  location            String?
  languages           String   // JSON array
  expertise           String   // JSON array
  status              String   @default("pending") // pending | approved | rejected
  reviewedBy          String?  // admin userId
  reviewedAt          DateTime?
  rejectionReason     String?
  resultingLawyerId   String?  // links to lawyers table once approved
  createdAt           DateTime @default(now())
}

// 5.6 — In-app notifications (user-facing feed with is_read)
model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId      String?
  case        Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  eventType   String   // draft_approved | draft_rejected | deadline_warning | handoff_sent | etc.
  message     String
  isRead      Boolean  @default(false)
  metadata    String?  // JSON
  createdAt   DateTime @default(now())
}

// 9.8 — Golden test set for legal-content regression testing
model GoldenTest {
  id              String   @id @default(cuid())
  testType        String   // calculator | rag_search
  inputQuery      String   // the input (case facts for calculator, query for RAG)
  expectedOutput  String   // JSON: expected categories for calculator, expected article_ids for RAG
  lastRunAt       DateTime?
  lastPassed      Boolean?
  lastResult      String?  // JSON of actual output on last run
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

// v3.3 §5.14 — Document Library: export log
model DocumentExport {
  id            String   @id @default(cuid())
  documentType  String   // 'complaint' | 'draft' | 'engagement_letter'
  documentId    String   // references complaints.id or drafts.id depending on documentType
  userId        String?
  caseId        String?
  exportType    String   // 'pdf_download' | 'print' | 'email'
  recipient     String?  // populated for 'email'
  createdAt     DateTime @default(now())
}
