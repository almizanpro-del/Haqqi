// Haqqi PRD v3.0 — Prisma schema (SQLite, MVP)
// Mirrors the data model in PRD §6.2 (adapted: arrays/JSON stored as String)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?
  role      String   @default("victim") // victim | lawyer | admin | regulator
  language  String   @default("ar")
  name      String?
  createdAt DateTime @default(now())
  cases     Case[]
  drafts    Draft[]
  engagementLetters EngagementLetter[]
}

model Case {
  id                  String      @id @default(cuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id])
  intakeJson          String      // JSON — output of AI intake (7 stages)
  stage               Int         @default(0) // current intake stage (0..7)
  completed           Boolean     @default(false)
  accidentDate        DateTime?
  location            String?
  accidentType        String?
  injuries            String?
  otherPartyInsured   Boolean?
  createdAt           DateTime    @default(now())
  claims              Claim[]
  drafts              Draft[]
  evidence            Evidence[]
  claimLogs           ClaimLog[]
  handoffPackets      HandoffPacket[]
  courtFilings        CourtFiling[]
  engagementLetters   EngagementLetter[]
}

model Claim {
  id            String       @id @default(cuid())
  caseId        String
  case          Case         @relation(fields: [caseId], references: [id])
  insurerName   String?
  policyNumber  String?
  status        String?
  amountClaimed Float?
  amountOffered Float?
  amountPaid    Float?
  createdAt     DateTime     @default(now())
  documents     Document[]
  claimLogs     ClaimLog[]
  complaints    Complaint[]
}

model Document {
  id         String   @id @default(cuid())
  claimId    String
  claim      Claim    @relation(fields: [claimId], references: [id])
  type       String
  fileName   String
  fileUrl    String?
  uploadedAt DateTime @default(now())
}

model Evidence {
  id         String   @id @default(cuid())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id])
  type       String   // police_report | croquis | photo | medical | bill | salary_slip | correspondence
  fileName   String
  fileUrl    String?
  note       String?
  uploadedAt DateTime @default(now())
}

model ClaimLog {
  id            String    @id @default(cuid())
  caseId        String
  case          Case      @relation(fields: [caseId], references: [id])
  claimId       String?
  claim         Claim?    @relation(fields: [claimId], references: [id])
  contactDate   DateTime
  contactPerson String?
  summary       String
  outcome       String?
  badFaithFlag  String?   // delay | unnecessary_request | lowball | misrepresentation | none
  createdAt     DateTime  @default(now())
}

model Draft {
  id                  String    @id @default(cuid())
  caseId              String?
  case                Case?     @relation(fields: [caseId], references: [id])
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  templateType        String    // insurer_demand | cbj_complaint | statement_of_claim | settlement_release | power_of_attorney | evidence_list | expert_request
  version             Int       @default(1)
  content             String
  plainArabicVersion  String?
  legalArabicVersion  String?
  citations           String?   // JSON array of {source, article_id, topic, language}
  reviewStatus        String    @default("pending_review") // pending_review | approved | rejected | sent
  reviewedByLawyerId  String?
  reviewComments      String?
  reviewedAt          DateTime?
  sentAt              DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  reviewLogs          ReviewLog[]
}

model Lawyer {
  id               String   @id @default(cuid())
  name             String
  firm             String?
  location         String?
  languages        String   // JSON array
  feeModel         String?
  expertise        String   // JSON array
  contactEmail     String?
  contactPhone     String?
  bio              String?
  successRate      Float?   // self-reported (PRD §5.2.4)
  isVerified       Boolean  @default(false)
  isLegalReviewer  Boolean  @default(false)
  createdAt        DateTime @default(now())
  reviews          LawyerReview[]
  handoffPackets   HandoffPacket[]
  engagementLetters EngagementLetter[]
}

model LegalRulesConfig {
  id                  String    @id @default(cuid())
  version             Int
  rulesJson           String    // JSON: compensation categories, ranges, deadlines, doc checklists
  isActive            Boolean   @default(false)
  approvedByLawyerId  String?
  approvedAt          DateTime?
  createdAt           DateTime  @default(now())
}

model LegalTemplate {
  id                  String    @id @default(cuid())
  templateType        String
  version             Int
  contentMdx          String
  isActive            Boolean   @default(false)
  approvedByLawyerId  String?
  approvedAt          DateTime?
  createdAt           DateTime  @default(now())
}

model LegalDocument {
  id                  String    @id @default(cuid())
  title               String
  content             String
  source              String?
  articleId           String?
  topics              String    // JSON array
  language            String    @default("ar")
  lawyerVerified      Boolean   @default(false)
  verifiedByLawyerId  String?
  verifiedAt          DateTime?
  createdAt           DateTime  @default(now())
}

model Story {
  id           String    @id @default(cuid())
  accidentDate DateTime?
  insurerName  String?
  description  String
  outcome      String?
  isApproved   Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

model CorruptionReport {
  id           String   @id @default(cuid())
  reportDate   DateTime @default(now())
  location     String?
  description  String
  evidenceUrls String   // JSON array
  isAnonymous  Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Complaint {
  id           String    @id @default(cuid())
  claimId      String
  claim        Claim     @relation(fields: [claimId], references: [id])
  target       String    // insurer | cbj | court
  templateType String?
  content      String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
}

model HandoffPacket {
  id                  String   @id @default(cuid())
  caseId              String
  case                Case     @relation(fields: [caseId], references: [id])
  lawyerId            String?
  lawyer              Lawyer?  @relation(fields: [lawyerId], references: [id])
  includedDocumentIds String   // JSON
  includedDraftIds    String   // JSON
  message             String?  // optional cover note from user to lawyer
  status              String   @default("sent") // sent | viewed | accepted | declined
  sentAt              DateTime @default(now())
}

model ReviewLog {
  id        String   @id @default(cuid())
  draftId   String
  draft     Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  action    String   // submitted | approved | rejected | sent | generated | edited
  actorId   String?
  comments  String?
  createdAt DateTime @default(now())
}

// === Phase 3 models (PRD §5.3) ===

model LawyerReview {
  id        String   @id @default(cuid())
  lawyerId  String
  lawyer    Lawyer   @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  userId    String?
  rating    Int      // 1..5
  comment   String?
  isVerifiedUser Boolean @default(false) // PRD §5.2.4: reviews restricted to verified accounts
  createdAt DateTime @default(now())
}

model EngagementLetter {
  id           String    @id @default(cuid())
  lawyerId     String
  lawyer       Lawyer    @relation(fields: [lawyerId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  caseId       String?
  case         Case?     @relation(fields: [caseId], references: [id])
  templateType String    // contingency | hourly_fixed
  content      String
  variablesJson String   // JSON of filled variables
  signedByUser Boolean    @default(false)
  signedByLawyer Boolean  @default(false)
  userSignedAt DateTime?
  lawyerSignedAt DateTime?
  status       String    @default("draft") // draft | signed_by_user | fully_signed | voided
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CourtFiling {
  id           String    @id @default(cuid())
  caseId       String
  case         Case      @relation(fields: [caseId], references: [id])
  filingType   String    // statement_of_claim | expert_request | appeal | enforcement
  courtName    String?
  content      String
  status       String    @default("draft") // draft | lawyer_approved | filed | rejected
  filedAt      DateTime?
  createdAt    DateTime  @default(now())
}

model ForumTopic {
  id           String    @id @default(cuid())
  title        String
  category     String    // general | insurance | medical | court | corruption | support
  body         String
  authorId     String?
  authorDisplayName String? // anonymous display name if no user
  isPinned     Boolean   @default(false)
  isLocked     Boolean   @default(false)
  views        Int       @default(0)
  createdAt    DateTime  @default(now())
  posts        ForumPost[]
}

model ForumPost {
  id           String    @id @default(cuid())
  topicId      String
  topic        ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorId     String?
  authorDisplayName String?
  body         String
  isModeratorApproved Boolean @default(false)
  isLawyerAnswer Boolean @default(false) // PRD §5.3.4: verified lawyer/NGO Q&A participation
  createdAt    DateTime  @default(now())
}

model RegulatorStat {
  // Aggregated, anonymized complaint/outcome data for the regulator dashboard (PRD §5.3.3)
  // k-anonymity applied at the query layer — never store individual case data here
  id           String    @id @default(cuid())
  period       String    // e.g. "2026-Q3"
  insurerName  String    // bucketed; small insurers grouped as "Other"
  totalComplaints Int
  resolvedFavorably Int
  avgResolutionDays Float?
  badFaithReports Int
  createdAt    DateTime  @default(now())
}

model NotificationLog {
  // Tracks every outbound notification (PRD §6.6) for audit + retry
  id           String    @id @default(cuid())
  userId       String?
  caseId       String?
  channel      String    // sms | whatsapp | email | in_app
  template     String    // e.g. "reminder_police_report", "draft_approved"
  recipient    String    // phone / email / user id
  payload      String    // JSON of variables
  status       String    @default("queued") // queued | sent | delivered | failed
  providerMessageId String?
  attempts     Int       @default(0)
  lastError    String?
  scheduledFor DateTime?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
}
